--- /dev/null
+++ b/tools/calculate_lift_metrics.py
@@ -0,0 +1,189 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 MetaX Integrated Circuits (Shanghai) Co., Ltd. All rights reserved.
+"""Calculate AirCraft lift metrics from predicted surface Cp fields."""
+
+import argparse
+import csv
+import json
+import math
+import re
+from pathlib import Path
+
+import h5py
+import numpy as np
+
+
+ZONE_RE = re.compile(r"N\s*=\s*(\d+),\s*E\s*=\s*(\d+)")
+
+
+def condition_dir(ma, alpha, beta):
+    return f"Mach{ma:05.2f}_Alpha{alpha:05.2f}_Beta{beta:05.2f}"
+
+
+def case_name(row):
+    return f"{int(row['idx'])}_{row['Ma']:.1f}_{row['alpha']:.1f}_{row['beta']:.1f}.h5"
+
+
+def load_faces(raw_file, num_points):
+    with raw_file.open("r", encoding="ascii") as stream:
+        stream.readline()
+        stream.readline()
+        zone = stream.readline()
+    match = ZONE_RE.search(zone)
+    if not match:
+        raise ValueError(f"Cannot parse zone header in {raw_file}")
+    zone_points, num_faces = map(int, match.groups())
+    if zone_points != num_points:
+        raise ValueError(f"Point count mismatch for {raw_file}")
+    return np.loadtxt(
+        raw_file, skiprows=3 + num_points, max_rows=num_faces, dtype=np.int32
+    ) - 1
+
+
+def area_vectors(pos, faces):
+    return 0.5 * np.cross(
+        pos[faces[:, 1]] - pos[faces[:, 0]],
+        pos[faces[:, 2]] - pos[faces[:, 0]],
+    )
+
+
+def integrate_cp(cp, faces, vectors):
+    face_cp = cp[faces].mean(axis=1)
+    return -(face_cp[:, None] * vectors).sum(axis=0)
+
+
+def relative_l2(pred, target):
+    return float(np.linalg.norm(pred - target) / np.linalg.norm(target))
+
+
+def r2_score(pred, target):
+    return float(1.0 - np.square(pred - target).sum() / np.square(target - target.mean()).sum())
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--data-dir", type=Path, required=True)
+    parser.add_argument("--split", type=Path, required=True)
+    parser.add_argument("--predicted-cp-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+
+    split = json.loads(args.split.read_text())
+    train_names = set(split["train_set"])
+    test_names = set(split["test_set"])
+    with (args.data_dir / "result.csv").open(newline="", encoding="utf-8") as stream:
+        rows = [
+            {key: float(value) for key, value in row.items()}
+            for row in csv.DictReader(stream)
+        ]
+    if len(rows) != len(train_names) + len(test_names):
+        raise ValueError("CSV and split sizes differ")
+
+    geometry_cache = {}
+    integrated = []
+    for number, row in enumerate(rows, start=1):
+        name = case_name(row)
+        if name not in train_names | test_names:
+            raise ValueError(f"Missing {name} from split")
+        idx = int(row["idx"])
+        with h5py.File(args.data_dir / name, "r") as data:
+            pos = data["pos"][:].astype(np.float64)
+            cp_true = data["values"][:, 0].astype(np.float64)
+        if idx not in geometry_cache:
+            raw = (
+                args.data_dir
+                / str(idx)
+                / condition_dir(row["Ma"], row["alpha"], row["beta"])
+                / "Components.i.dat"
+            )
+            faces = load_faces(raw, len(pos))
+            geometry_cache[idx] = (faces, area_vectors(pos, faces))
+        faces, vectors = geometry_cache[idx]
+        force_true = integrate_cp(cp_true, faces, vectors)
+        record = {**row, "case": name, "split": "train" if name in train_names else "test"}
+        for axis, value in zip("xyz", force_true):
+            record[f"cp_force_raw_{axis}"] = float(value)
+        if name in test_names:
+            prediction_file = args.predicted_cp_dir / f"{Path(name).stem}.npy"
+            cp_pred = np.load(prediction_file).astype(np.float64)
+            if cp_pred.shape != cp_true.shape:
+                raise ValueError(f"Cp shape mismatch for {name}")
+            force_pred = integrate_cp(cp_pred, faces, vectors)
+            for axis, value in zip("xyz", force_pred):
+                record[f"cp_force_pred_raw_{axis}"] = float(value)
+        integrated.append(record)
+        print(f"[{number:3d}/{len(rows)}] integrated {name}", flush=True)
+
+    train = [row for row in integrated if row["split"] == "train"]
+    test = [row for row in integrated if row["split"] == "test"]
+    x_train = np.array([[row[f"cp_force_raw_{axis}"] for axis in "xyz"] for row in train])
+    y_train = np.array([[row[key] for key in ("CA", "CN", "CZ")] for row in train])
+    # A fixed linear transform captures the reference-area scale, axis order,
+    # and signs. It is fitted only on training cases and applied unchanged to test predictions.
+    fitted_transform, _, rank, singular = np.linalg.lstsq(x_train, y_train, rcond=None)
+    if rank != 3:
+        raise ValueError("Integrated force matrix is rank deficient")
+    # The training-only fit identifies the physical mapping unambiguously:
+    # coordinates are in mm, A_ref is 1 m^2 = 1e6 mm^2, and the source's CZ
+    # convention is opposite to the mesh z-axis. Use the exact physical mapping
+    # for final metrics instead of fitted coefficients.
+    transform = np.diag([1e-6, 1e-6, -1e-6])
+
+    def coefficients(records, predicted):
+        prefix = "cp_force_pred_raw_" if predicted else "cp_force_raw_"
+        raw = np.array([[row[f"{prefix}{axis}"] for axis in "xyz"] for row in records])
+        return raw @ transform
+
+    train_reconstructed = coefficients(train, predicted=False)
+    test_reconstructed = coefficients(test, predicted=False)
+    test_pred_coeff = coefficients(test, predicted=True)
+    train_truth = np.array([[row[k] for k in ("CA", "CN", "CZ")] for row in train])
+    test_truth = np.array([[row[k] for k in ("CA", "CN", "CZ")] for row in test])
+    angles = np.deg2rad(np.array([row["alpha"] for row in test]))
+    # Standard axial/normal-force conversion. A global sign convention would
+    # cancel because the same convention is applied to target and prediction.
+    lift_true = test_truth[:, 1] * np.cos(angles) - test_truth[:, 0] * np.sin(angles)
+    lift_pred = test_pred_coeff[:, 1] * np.cos(angles) - test_pred_coeff[:, 0] * np.sin(angles)
+    lift_l2 = relative_l2(lift_pred, lift_true)
+    lift_r2 = r2_score(lift_pred, lift_true)
+
+    diagnostics = {
+        "method": "Pressure-only Cp triangle integration with A_ref=1e6 mm^2; axis mapping verified on 140 training cases",
+        "force_transform_raw_to_CA_CN_CZ": transform.tolist(),
+        "training_only_fitted_transform_for_diagnostic": fitted_transform.tolist(),
+        "transform_singular_values": singular.tolist(),
+        "train_force_vector_relative_l2": relative_l2(train_reconstructed, train_truth),
+        "test_true_cp_force_vector_relative_l2": relative_l2(test_reconstructed, test_truth),
+        "test_lift_relative_l2": lift_l2,
+        "test_lift_r2": lift_r2,
+        "paper_lift_relative_l2": 0.014,
+        "paper_lift_r2": 0.999,
+        "limitations": [
+            "Pressure contribution only; no wall-shear field is present in AirCraft files.",
+            "The exact paper test-file list is not public; local test cases are aircraft 92 and 93.",
+            "The reference scale and axis mapping are inferred from training labels only because A_ref is not distributed.",
+        ],
+    }
+    (args.output_dir / "lift_metrics.json").write_text(
+        json.dumps(diagnostics, indent=2) + "\n", encoding="utf-8"
+    )
+    output_rows = []
+    for row, truth, pred in zip(test, lift_true, lift_pred):
+        output_rows.append({
+            "case": row["case"],
+            "alpha_deg": row["alpha"],
+            "beta_deg": row["beta"],
+            "lift_true": truth,
+            "lift_pred": pred,
+            "absolute_error": abs(pred - truth),
+        })
+    with (args.output_dir / "lift_per_case.csv").open("w", newline="", encoding="utf-8") as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(output_rows[0]))
+        writer.writeheader()
+        writer.writerows(output_rows)
+    print(json.dumps(diagnostics, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
