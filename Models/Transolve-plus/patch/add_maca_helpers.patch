+#!/usr/bin/env python3
+# Copyright (c) 2026 MetaX Integrated Circuits (Shanghai) Co., Ltd. All rights reserved.
+"""Convert the raw AirCraft Tecplot files to Transolver++ HDF5 inputs."""
+
+import argparse
+import csv
+import json
+import re
+from pathlib import Path
+
+import h5py
+import numpy as np
+
+
+ZONE_RE = re.compile(r"N\s*=\s*(\d+),\s*E\s*=\s*(\d+)")
+
+
+def condition_dir(ma: float, alpha: float, beta: float) -> str:
+    return f"Mach{ma:05.2f}_Alpha{alpha:05.2f}_Beta{beta:05.2f}"
+
+
+def output_name(idx: int, ma: float, alpha: float, beta: float) -> str:
+    return f"{idx}_{ma:.1f}_{alpha:.1f}_{beta:.1f}.h5"
+
+
+def read_case(path: Path, read_faces: bool):
+    with path.open("r", encoding="ascii") as stream:
+        stream.readline()
+        stream.readline()
+        zone = stream.readline()
+    match = ZONE_RE.search(zone)
+    if not match:
+        raise ValueError(f"Cannot parse mesh dimensions from {path}: {zone.strip()}")
+
+    num_points, num_faces = map(int, match.groups())
+    point_data = np.loadtxt(path, skiprows=3, max_rows=num_points, dtype=np.float32)
+    faces = None
+    if read_faces:
+        faces = np.loadtxt(
+            path, skiprows=3 + num_points, max_rows=num_faces, dtype=np.int32
+        ) - 1
+    return point_data, faces
+
+
+def vertex_normals(pos: np.ndarray, faces: np.ndarray) -> np.ndarray:
+    p0 = pos[faces[:, 0]]
+    p1 = pos[faces[:, 1]]
+    p2 = pos[faces[:, 2]]
+    face_normals = np.cross(p1 - p0, p2 - p0)
+    normals = np.zeros_like(pos, dtype=np.float32)
+    np.add.at(normals, faces[:, 0], face_normals)
+    np.add.at(normals, faces[:, 1], face_normals)
+    np.add.at(normals, faces[:, 2], face_normals)
+    lengths = np.linalg.norm(normals, axis=1, keepdims=True)
+    if np.any(lengths == 0):
+        raise ValueError("Mesh contains vertices with zero accumulated normal")
+    return normals / lengths
+
+
+def write_h5(path: Path, points: np.ndarray, normals: np.ndarray, row: dict):
+    with h5py.File(path, "w") as output:
+        output.create_dataset("pos", data=points[:, :3], compression="gzip")
+        output.create_dataset("normals", data=normals, compression="gzip")
+        output.create_dataset("values", data=points[:, 3:9], compression="gzip")
+        output.attrs["Ma"] = float(row["Ma"])
+        output.attrs["alpha"] = float(row["alpha"])
+        output.attrs["beta"] = float(row["beta"])
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--data-dir", type=Path, required=True)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--test-count", type=int, default=10)
+    args = parser.parse_args()
+
+    with (args.data_dir / "result.csv").open(newline="", encoding="utf-8") as stream:
+        rows = list(csv.DictReader(stream))
+    if len(rows) != 150:
+        raise ValueError(f"Expected 150 cases, found {len(rows)}")
+
+    names = []
+    cached_idx = None
+    cached_pos = None
+    cached_normals = None
+
+    for number, row in enumerate(rows, start=1):
+        idx = int(float(row["idx"]))
+        ma = float(row["Ma"])
+        alpha = float(row["alpha"])
+        beta = float(row["beta"])
+        name = output_name(idx, ma, alpha, beta)
+        destination = args.data_dir / name
+        source = args.data_dir / str(idx) / condition_dir(ma, alpha, beta) / "Components.i.dat"
+
+        if idx != cached_idx:
+            points, faces = read_case(source, read_faces=True)
+            cached_pos = points[:, :3].copy()
+            cached_normals = vertex_normals(cached_pos, faces)
+            cached_idx = idx
+        else:
+            points, _ = read_case(source, read_faces=False)
+            if points.shape[0] != cached_pos.shape[0] or not np.allclose(
+                points[:, :3], cached_pos, rtol=0, atol=1e-4
+            ):
+                raise ValueError(f"Mesh changed between conditions for aircraft {idx}")
+
+        if destination.exists():
+            with h5py.File(destination, "r") as existing:
+                complete = all(key in existing for key in ("pos", "normals", "values"))
+                complete = complete and existing["pos"].shape == cached_pos.shape
+            if complete:
+                print(f"[{number:3d}/150] keep {name}", flush=True)
+                names.append(name)
+                continue
+
+        temporary = destination.with_suffix(".h5.tmp")
+        write_h5(temporary, points, cached_normals, row)
+        temporary.replace(destination)
+        names.append(name)
+        print(f"[{number:3d}/150] wrote {name}", flush=True)
+
+    split = {
+        "train_set": names[:-args.test_count],
+        "test_set": names[-args.test_count:],
+    }
+    args.config.parent.mkdir(parents=True, exist_ok=True)
+    args.config.write_text(json.dumps(split, indent=4) + "\n", encoding="utf-8")
+    print(
+        f"Wrote {args.config}: {len(split['train_set'])} train, "
+        f"{len(split['test_set'])} test",
+        flush=True,
+    )
+
+
+if __name__ == "__main__":
+    main()
