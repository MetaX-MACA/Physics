+#!/usr/bin/env python3
+# Copyright (c) 2026 MetaX Integrated Circuits (Shanghai) Co., Ltd. All rights reserved.
+"""Plot AirCraft Cp ground truth, prediction, and absolute error."""
+
+import argparse
+import re
+import warnings
+from pathlib import Path
+
+import matplotlib
+
+warnings.filterwarnings("ignore", message="Unable to import Axes3D")
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+
+
+ZONE_RE = re.compile(r"N\s*=\s*(\d+),\s*E\s*=\s*(\d+)")
+
+
+def read_surface(path: Path):
+    with path.open("r", encoding="ascii") as stream:
+        stream.readline()
+        stream.readline()
+        zone = stream.readline()
+    match = ZONE_RE.search(zone)
+    if not match:
+        raise ValueError(f"Cannot parse mesh dimensions from {path}: {zone.strip()}")
+    num_points = int(match.group(1))
+    data = np.loadtxt(
+        path,
+        skiprows=3,
+        max_rows=num_points,
+        usecols=(0, 1, 2, 3),
+        dtype=np.float32,
+    )
+    return data[:, :3], data[:, 3]
+
+
+def project(points: np.ndarray):
+    view = np.array((0.20, 1.0, 0.30), dtype=np.float64)
+    view /= np.linalg.norm(view)
+    right = np.cross(np.array((0.0, 0.0, 1.0)), view)
+    right /= np.linalg.norm(right)
+    up = np.cross(view, right)
+    centered = points.astype(np.float64) - points.mean(axis=0)
+    screen = np.column_stack((centered @ right, centered @ up))
+    depth = centered @ view
+
+    angle = np.deg2rad(-13.0)
+    rotation = np.array(
+        ((np.cos(angle), -np.sin(angle)), (np.sin(angle), np.cos(angle)))
+    )
+    return screen @ rotation.T, depth
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--surface", type=Path, required=True)
+    parser.add_argument("--prediction", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--case-label", default="AirCraft test case")
+    parser.add_argument("--max-points", type=int, default=220_000)
+    args = parser.parse_args()
+
+    points, target = read_surface(args.surface)
+    prediction = np.load(args.prediction).reshape(-1).astype(np.float32)
+    if prediction.shape != target.shape:
+        raise ValueError(
+            f"Prediction shape {prediction.shape} does not match target {target.shape}"
+        )
+
+    screen, depth = project(points)
+    if args.max_points > 0 and len(target) > args.max_points:
+        rng = np.random.default_rng(0)
+        selected = rng.choice(len(target), size=args.max_points, replace=False)
+    else:
+        selected = np.arange(len(target))
+    selected = selected[np.argsort(depth[selected])]
+
+    screen = screen[selected]
+    target_plot = target[selected]
+    prediction_plot = prediction[selected]
+    error_plot = np.abs(prediction_plot - target_plot)
+
+    field_values = np.concatenate((target, prediction))
+    field_min, field_max = np.percentile(field_values, (0.5, 99.5))
+    error_max = float(np.percentile(np.abs(prediction - target), 99.5))
+    relative_l2 = np.linalg.norm(prediction - target) / np.linalg.norm(target)
+    mae = np.mean(np.abs(prediction - target))
+
+    plt.rcParams.update(
+        {
+            "font.family": "DejaVu Sans",
+            "font.size": 10,
+            "axes.titleweight": "semibold",
+        }
+    )
+    fig, axes = plt.subplots(1, 3, figsize=(15.2, 5.2))
+    fig.subplots_adjust(left=0.01, right=0.99, bottom=0.20, top=0.80, wspace=0.04)
+    panels = (
+        (target_plot, "Ground truth", "coolwarm", field_min, field_max),
+        (prediction_plot, "Prediction", "coolwarm", field_min, field_max),
+        (error_plot, "Absolute error", "magma", 0.0, error_max),
+    )
+
+    artists = []
+    x_margin = np.ptp(screen[:, 0]) * 0.025
+    y_margin = np.ptp(screen[:, 1]) * 0.025
+    for axis, (values, title, cmap, vmin, vmax) in zip(axes, panels):
+        artist = axis.scatter(
+            screen[:, 0],
+            screen[:, 1],
+            c=values,
+            s=0.42,
+            cmap=cmap,
+            vmin=vmin,
+            vmax=vmax,
+            linewidths=0,
+            rasterized=True,
+        )
+        axis.set_title(title, pad=6)
+        axis.set_xlim(screen[:, 0].min() - x_margin, screen[:, 0].max() + x_margin)
+        axis.set_ylim(screen[:, 1].min() - y_margin, screen[:, 1].max() + y_margin)
+        axis.set_aspect("equal")
+        axis.set_axis_off()
+        artists.append(artist)
+
+    field_bar_axis = fig.add_axes((0.12, 0.09, 0.50, 0.035))
+    field_bar = fig.colorbar(artists[1], cax=field_bar_axis, orientation="horizontal")
+    field_bar.set_label("Pressure coefficient, Cp")
+    error_bar_axis = fig.add_axes((0.73, 0.09, 0.20, 0.035))
+    error_bar = fig.colorbar(artists[2], cax=error_bar_axis, orientation="horizontal")
+    error_bar.set_label("Absolute error, |prediction - target|")
+    fig.suptitle(
+        f"{args.case_label}   |   Cp MAE = {mae:.5f}, Relative L2 = {relative_l2:.2%}",
+        fontsize=14,
+        fontweight="semibold",
+        y=0.97,
+    )
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    fig.savefig(args.output, dpi=220, facecolor="white", bbox_inches="tight")
+    plt.close(fig)
+    print(f"Saved {args.output}")
+
+
+if __name__ == "__main__":
+    main()
