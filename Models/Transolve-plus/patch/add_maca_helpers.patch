@@ -0,0 +1,233 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 MetaX Integrated Circuits (Shanghai) Co., Ltd. All rights reserved.
+"""Extract logged metrics and independently evaluate the saved AirCraft model."""
+
+import argparse
+import csv
+import faulthandler
+import hashlib
+import json
+import signal
+from pathlib import Path
+import sys
+
+import h5py
+import numpy as np
+import torch
+import torch.distributed as dist
+import torch.distributed.nn as dist_nn
+
+
+PAPER_URL = "https://arxiv.org/html/2502.02414"
+FIELDS = ("Cp", "rho", "u", "v", "w", "p")
+POS_MEAN = (2808.79162, 100.957077, 0.00676594237)
+POS_STD = (1436.65326859, 178.37956359, 615.16521715)
+OUT_MEAN = (0.04602036, 1.3157164, 5.66693757, 0.25599, 0.06231503, 1.64027649)
+OUT_STD = (0.09458788, 0.76978003, 0.41717544, 0.47068753, 0.6710297, 1.8059161)
+
+
+def write_csv(path, rows):
+    with path.open("w", newline="", encoding="utf-8") as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def main():
+    faulthandler.register(signal.SIGUSR1)
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--repo", type=Path, default=Path("/workspace/Transolver_plus"))
+    parser.add_argument("--run-dir", type=Path, required=True)
+    parser.add_argument("--data-dir", type=Path, default=Path("/pde_hpc/share/m01720"))
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument(
+        "--save-predicted-cp",
+        action="store_true",
+        help="Save predicted vertex Cp for aerodynamic-coefficient postprocessing.",
+    )
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    if (args.output_dir / "summary.json").exists():
+        raise FileExistsError("Existing summary.json will not be overwritten; use another output directory")
+
+    sys.path.insert(0, str(args.repo))
+    logged = json.loads((args.run_dir / "log_200.json").read_text())
+    split = json.loads((args.run_dir / "airplane_dataset.json").read_text())
+    train_cases = set(split["train_set"])
+    test_cases = split["test_set"]
+    if len(set(test_cases)) != len(test_cases) or train_cases.intersection(test_cases):
+        raise ValueError("Duplicate test cases or train/test overlap")
+    checkpoint = args.run_dir / "model_200.pth"
+    rows = []
+
+    torch.manual_seed(args.seed)
+    torch.cuda.manual_seed_all(args.seed)
+    torch.cuda.set_device(0)
+    device = torch.device("cuda:0")
+    # For a single rank, SUM all_reduce is exactly the identity. Avoid starting
+    # a communicator just to perform that identity during this local evaluation.
+    def single_rank_all_reduce(tensor, op=dist.ReduceOp.SUM, group=None):
+        if op != dist.ReduceOp.SUM or group is not None:
+            raise ValueError("Only single-rank SUM reduction is supported")
+        return tensor
+
+    with torch.cuda.device(device):
+        original_all_reduce = dist_nn.all_reduce
+        dist_nn.all_reduce = single_rank_all_reduce
+        try:
+            # This checkpoint was created locally by the authorized training run.
+            model = torch.load(checkpoint, map_location="cpu", weights_only=False).to(device)
+            model.eval()
+            print("Loaded final checkpoint; evaluating 10 cases", flush=True)
+            pos_mean = torch.tensor(POS_MEAN, device=device).view(1, 1, 3)
+            pos_std = torch.tensor(POS_STD, device=device).view(1, 1, 3)
+            out_mean = torch.tensor(OUT_MEAN, device=device).view(1, 1, 6)
+            out_std = torch.tensor(OUT_STD, device=device).view(1, 1, 6)
+
+            with torch.no_grad():
+                for case in test_cases:
+                    with h5py.File(args.data_dir / case, "r") as data:
+                        pos = torch.from_numpy(data["pos"][:]).unsqueeze(0).float().to(device)
+                        normals = torch.from_numpy(data["normals"][:]).unsqueeze(0).float().to(device)
+                        values = torch.from_numpy(data["values"][:]).unsqueeze(0).float().to(device)
+                        condition_values = [float(data.attrs[key]) for key in ("Ma", "alpha", "beta")]
+                    condition = torch.tensor(condition_values, device=device).view(1, 3)
+                    pos = (pos - pos_mean) / pos_std
+                    x = torch.cat((pos, torch.zeros_like(pos[..., :1]), normals), dim=-1)
+                    normalized_pred = model((x, pos, condition))
+                    normalized_target = (values - out_mean) / (out_std + 1e-6)
+                    normalized_mse = (normalized_pred - normalized_target).square().mean().item()
+                    pred = normalized_pred * out_std + out_mean
+                    # Same float32 pressure Relative L2 as train_airplane.test().
+                    pressure_l2 = ((pred[..., -1] - values[..., -1]).norm() / values[..., -1].norm()).item()
+                    row = {
+                        "case": case,
+                        "points": pos.shape[1],
+                        "Ma": condition_values[0],
+                        "alpha": condition_values[1],
+                        "beta": condition_values[2],
+                        "normalized_mse_six_outputs": normalized_mse,
+                        "pressure_relative_l2": pressure_l2,
+                        "pressure_relative_l2_percent": pressure_l2 * 100,
+                    }
+                    pred_np = pred[0].cpu().numpy().astype(np.float64)
+                    target_np = values[0].cpu().numpy().astype(np.float64)
+                    if args.save_predicted_cp:
+                        cp_dir = args.output_dir / "predicted_cp"
+                        cp_dir.mkdir(exist_ok=True)
+                        np.save(cp_dir / f"{Path(case).stem}.npy", pred_np[:, 0].astype(np.float32))
+                    for index, field in enumerate(FIELDS):
+                        delta = pred_np[:, index] - target_np[:, index]
+                        row[f"{field}_mae_original_scale"] = float(np.abs(delta).mean())
+                        row[f"{field}_mse_original_scale"] = float(np.square(delta).mean())
+                        row[f"{field}_relative_l2"] = float(np.linalg.norm(delta) / np.linalg.norm(target_np[:, index]))
+                    rows.append(row)
+                    print(f"{case}: pressure Relative L2 = {pressure_l2 * 100:.6f}%", flush=True)
+        finally:
+            dist_nn.all_reduce = original_all_reduce
+
+    write_csv(args.output_dir / "per_case_metrics.csv", rows)
+    mean_pressure = float(np.mean([row["pressure_relative_l2"] for row in rows]))
+    mean_mse = float(np.mean([row["normalized_mse_six_outputs"] for row in rows]))
+    log_pressure = float(logged["val_loss_l2re"])
+    paper_pressure = 0.064
+    elapsed = float(logged["time_elapsed"])
+    summary = {
+        "hardware": "MetaX C500 (confirmed by mx-smi)",
+        "checkpoint": str(checkpoint),
+        "checkpoint_sha256": hashlib.sha256(checkpoint.read_bytes()).hexdigest(),
+        "paper_url": PAPER_URL,
+        "paper_table": "Table 2, AirCraft",
+        "train_samples": len(split["train_set"]),
+        "test_samples": len(test_cases),
+        "test_cases": test_cases,
+        "split_note": "Local split: first 140 / last 10 rows of result.csv; exact paper file list is unverified.",
+        "logged": logged,
+        "paper": {"surface_relative_l2": 0.064, "lift_relative_l2": 0.014, "lift_r2": 0.999},
+        "logged_pressure_minus_paper_percentage_points": (log_pressure - paper_pressure) * 100,
+        "logged_pressure_relative_difference_percent": (log_pressure / paper_pressure - 1) * 100,
+        "reevaluation": {
+            "seed": args.seed,
+            "order": "test_set list order",
+            "single_rank_sum_reduction": "identity (no distributed communicator)",
+            "mean_pressure_relative_l2": mean_pressure,
+            "mean_normalized_mse_six_outputs": mean_mse,
+            "note": "Upstream Gumbel sampling remains random in eval mode; this is a new draw, not exact replay of logged validation.",
+        },
+        "lift_metrics": {
+            "status": "not_computed",
+            "reason": "No official lift postprocessing implementation or complete reference parameters / wall-shear fields available; result.csv Cl is not confirmed to be lift coefficient C_L.",
+        },
+    }
+    (args.output_dir / "summary.json").write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n")
+
+    comparison_rows = [
+        {"metric": "Surface pressure Relative L2", "metax_c500": log_pressure, "paper": paper_pressure,
+         "source": "log_200.json: val_loss_l2re", "status": "logged; local split not confirmed identical to paper"},
+        {"metric": "Lift coefficient Relative L2", "metax_c500": "", "paper": 0.014,
+         "source": "not available", "status": "not computed"},
+        {"metric": "Lift coefficient R2", "metax_c500": "", "paper": 0.999,
+         "source": "not available", "status": "not computed"},
+    ]
+    write_csv(args.output_dir / "paper_comparison.csv", comparison_rows)
+    report = f"""# Transolver++ AirCraft 论文对标数据
+
+| 指标 | MetaX C500 | 论文 Transolver++（Table 2） |
+| --- | ---: | ---: |
+| Surface pressure Relative L2 | {log_pressure * 100:.4f}% | 6.4% |
+| Lift coefficient Relative L2 | 未计算 | 1.4% |
+| Lift coefficient R² | 未计算 | 0.999 |
+
+表面压力指标来自最终 epoch 的 `log_200.json`，在 10 个测试工况上分别计算 `‖p_pred − p_true‖₂ / ‖p_true‖₂` 后取算术平均。使用反标准化后的原始数据尺度；上游代码用 6 个输出中的最后一列 `Pressure` 计算该指标。论文对照值见 [Table 2]({PAPER_URL})。两者相差 {(log_pressure - paper_pressure) * 100:.4f} 个百分点，相对论文数值变化 {(log_pressure / paper_pressure - 1) * 100:.4f}%。这只是数值对照，不构成严格同划分的性能优劣结论。
+
+## 实验配置
+
+- 设备：MetaX C500，容器 `a4cb4587a1ce`，由 `mx-smi` 确认。
+- 训练集 / 测试集：140 / 10；测试为机型 92、93 各 5 个工况。
+- 划分方式：按 `result.csv` 顺序取前 140 条训练、后 10 条测试；未核实与论文的具体文件划分完全一致。
+- 每个工况使用全部 331,971 个表面点。
+- Epoch：200；batch size：1；Adam；初始学习率：0.001。
+- 模型：4 层、8 heads、hidden 256、32 slices、6 输出，共 {int(logged['nb_parameters']):,} 个参数。
+- 总训练耗时：{elapsed:.2f} 秒（{int(elapsed // 3600)} 小时 {int(elapsed % 3600 // 60)} 分 {elapsed % 60:.2f} 秒）。
+- 最终训练 MSE：{logged['train_loss']:.10f}；最终测试 MSE：{logged['val_loss_mse']:.10f}，均为 6 输出归一化空间的均方误差，论文未在对应表中提供这两个数值。
+
+## 最终模型复核
+
+以固定种子 {args.seed}、`test_set` 顺序重新评估 `model_200.pth`：
+
+- 10 个工况平均压力 Relative L2：{mean_pressure * 100:.4f}%。
+- 6 输出平均归一化 MSE：{mean_mse:.10f}。
+- 逐工况结果及各输出的原始尺度 MAE / MSE 见 `per_case_metrics.csv`。
+
+上游 Gumbel 采样在 `eval()` 模式下仍生成随机数；因此本次独立复核与训练末尾评估并非同一次随机采样。用于论文对照的最终训练结果仍保留日志中的 {log_pressure * 100:.4f}%，复核值单独记录。
+
+复核仅用单张 GPU，将单进程 `SUM all_reduce` 按数学等价的恒等操作执行；此替换仅限复核进程，不修改模型源文件或原 checkpoint。
+
+## 升力指标的限制
+
+上游公开脚本仅评估表面压力，未提供升力系数后处理。当前 HDF5 保存坐标、法向量和 `Cp, rho, u, v, w, p`，未保存完整的剪切应力及参考面积等积分参数。`result.csv` 含 `CA, CN, CZ, Cl, Cn, Cm`，其中 `Cl` 的命名不能直接认定为论文的升力系数 `C_L`。因此不将这些列冒充已复现的升力指标，论文两项升力结果暂列未计算。
+
+## 文件
+
+- `paper_comparison.csv`：与论文并排的指标。
+- `summary.json`：日志原值、复核均值、checkpoint SHA-256 和口径说明。
+- `per_case_metrics.csv`：10 个测试工况的详细误差。
+- `extract_metrics.py`：提取与复核脚本。
+
+容器内复核命令（另选输出目录可再次评估，避免覆盖已有数据）：
+
+```bash
+python /work/Transolver_plus/paper_comparison/extract_metrics.py \\
+  --run-dir /work/Transolver_plus \\
+  --output-dir /work/Transolver_plus/paper_comparison/new_evaluation
+```
+"""
+    (args.output_dir / "PAPER_COMPARISON_ZH.md").write_text(report, encoding="utf-8")
+    print(f"Logged pressure Relative L2: {log_pressure * 100:.6f}%")
+    print(f"Reevaluated pressure Relative L2: {mean_pressure * 100:.6f}%")
+    print(f"Saved results to {args.output_dir}")
+
+
+if __name__ == "__main__":
+    main()
